# Copy to .env and adjust for your machine.
#   cp .env.example .env

# Host running the Erlang server.
# 127.0.0.1 is correct when both processes run on the same machine.
# On a second machine, use the server's reachable IP, e.g. 192.0.2.10
ERLANG_HOST=127.0.0.1

# TCP port bridge_server:start_link/1 was given.
ERLANG_PORT=4040