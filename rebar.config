%% Build configuration for the erl_bridge OTP application.
%%
%% The only dependency is `telemetry`, the standard instrumentation API.
%% `telemetry_metrics_prometheus_core` was deliberately avoided: every
%% release of `telemetry_metrics` is published as a mix project with no
%% rebar.config, so pulling it in would force Elixir/mix into an
%% Erlang-only toolchain. The Prometheus text exposition is rendered by
%% erl_bridge_metrics instead. Telemetry events are the portable part, so
%% another backend can be attached later without changing call sites.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [{telemetry, "1.3.0"}]}.

{shell, [{apps, [erl_bridge]}]}.

{profiles, [
    {test, [{erl_opts, [nowarn_export_all, export_all]}]}
]}.

%% Treat these as errors. An exported-but-unused function in a demo is
%% still dead code that misleads readers about the real API surface.
{xref_checks, [undefined_function_calls,
               locals_not_used,
               deprecated_function_calls,
               deprecated_functions]}.

{dialyzer, [{warnings, [unknown, no_return]}]}.

{edoc_opts, [{preamble, "erl_bridge"}]}.

{eunit_opts, [verbose]}.
