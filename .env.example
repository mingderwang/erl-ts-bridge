# Copy to .env and adjust for your machine.
#   cp .env.example .env

# ---- client (src/client.ts) ----

# Host running the Erlang server.
# 127.0.0.1 is correct when both processes run on the same machine.
# On a second machine, use the server's reachable IP, e.g. 192.0.2.10
ERL_BRIDGE_HOST=127.0.0.1

# TCP port the server was given.
ERL_BRIDGE_PORT=4040

# Shared secret. Must match the server's ERL_BRIDGE_TOKEN.
# Generate one with: openssl rand -hex 32
# Leave empty when the server has authentication disabled.
ERL_BRIDGE_TOKEN=

# Set to 1 to connect over TLS.
ERL_BRIDGE_TLS=0

# CA certificate used to verify the server, when TLS is enabled.
ERL_BRIDGE_TLS_CA=

# ---- server (Erlang) ----

# Enable TLS by supplying both files.
ERL_BRIDGE_TLS_CERTFILE=
ERL_BRIDGE_TLS_KEYFILE=

# Expose Prometheus metrics on 127.0.0.1:<port>/metrics.
ERL_BRIDGE_METRICS_PORT=

# Set to false to make a duplicate launch fail loudly with eaddrinuse.
# With the default (true), several instances share the port via
# SO_REUSEPORT and a duplicate launch is silent.
ERL_BRIDGE_REUSEPORT=true
